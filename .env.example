POSTGRES_DB=airfare_db
POSTGRES_USER=airfare_user
POSTGRES_PASSWORD=replace-with-a-strong-password

JWT_SECRET_KEY=replace-with-at-least-32-random-characters
# Fallback baseline, used only until 30 days of price history exist
BASELINE_AVERAGE_PRICE=5000
# Hours between automatic collection runs (scheduler)
COLLECTION_INTERVAL_HOURS=3

# FlightAPI.io API key — get yours at https://www.flightapi.io
FLIGHTAPI_API_KEY=replace-with-your-flightapi-key
# "direct" writes price events straight to PostgreSQL;
# set FLIGHTAPI_STORE_MODE=kafka together with --profile full
# to route events through Kafka instead.
FLIGHTAPI_STORE_MODE=direct

POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
FASTAPI_PORT=8010
